# Copy to .env and fill in. Never commit .env.
# PostgreSQL (role created with: CREATE ROLE buyorwait LOGIN PASSWORD '...' CREATEDB;)
POSTGRES_URL=postgresql://buyorwait:CHANGE_ME@localhost:5432/buyorwait
# Scratch database for pytest (dropped and recreated by the tests)
TEST_POSTGRES_URL=postgresql://buyorwait:CHANGE_ME@localhost:5432/buyorwait_test
# Empty = in-memory MongoDB started by the app (data lost on exit). Set e.g. mongodb://localhost:27017 for a real server.
MONGO_URL=
# rules (offline, default) | gemini (needs GEMINI_API_KEY)
EXTRACTOR=rules
GEMINI_API_KEY=
# Decision date. 2026-11-20 reproduces the master document's Appendix B. Empty = today.
AS_OF_DATE=2026-11-20
